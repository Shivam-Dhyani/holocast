[Unit]
Description=Holocast worker (packer, bot events, Lab)
After=network.target redis-server.service

[Service]
Type=simple
User=holocast
WorkingDirectory=/opt/holocast/apps/api
EnvironmentFile=/etc/holocast/holocast.env
ExecStart=/usr/bin/node dist/worker.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
