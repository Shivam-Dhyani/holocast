# Holocast environment (TDD §4.8). Copy to /etc/holocast/holocast.env in prod
# (mode 600) or apps/api/.env for local dev. NEVER commit real secrets.
# Generate 32-byte secrets with: openssl rand -base64 32

# --- domain / app ---
HOLOCAST_DOMAIN=holocast.duckdns.org
PUBLIC_BASE_URL=https://holocast.duckdns.org
NODE_ENV=development

# --- database (Neon) ---
# pooled connection string:
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# direct connection string (Prisma migrations use directUrl):
DIRECT_URL=postgresql://user:pass@host/db?sslmode=require

# --- redis (local on the VM) ---
REDIS_URL=redis://127.0.0.1:6379

# --- telegram ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=HolocastStorageBot
# which membership-event source is active: botapi | mtproto
BOT_EVENT_SOURCE=botapi
TG_SESSION_DIR=/var/lib/holocast/tg-sessions

# --- encryption / secrets (base64 32 bytes each) ---
# key-encryption-key ring; first id is active, e.g. k2026a:<base64 32 bytes>
STORAGE_KEKS=
APP_SECRET_KEY=
MEDIA_URL_SECRET=
UNLOCK_COOKIE_SECRET=

# comma-separated Telegram user ids allowed into /lab
ADMIN_TELEGRAM_IDS=

# --- spool ---
SPOOL_DIR=/var/lib/holocast/spool

# --- Cloudflare R2 ---
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=holocast-cache
R2_MAX_BYTES=9000000000
R2_MAX_CLASS_A_PER_MONTH=900000
R2_MAX_CLASS_B_PER_MONTH=9000000

# --- rate limits (FR-FAIR / TDD §11.8) ---
RATE_ACTIVE_RECORDINGS=1
RATE_VIDEOS_PER_HOUR=30
RATE_SEGMENT_RPS=10
RATE_MEDIA_PER_MIN=300
RATE_UNLOCK=10
RATE_API_DEFAULT=120

# --- whisper (T-TRN-01, Lab only) ---
WHISPER_BIN=/opt/whisper.cpp/build/bin/whisper-cli
WHISPER_MODEL=/opt/whisper.cpp/models/ggml-base.bin
